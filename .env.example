# Local development only. Vercel sets the port automatically for functions.
PORT=5000

# Comma-separated list of allowed frontend origins.
# In production use the deployed client URL, e.g. https://your-client.vercel.app
FRONTEND_URL=http://localhost:5173

# Use a MongoDB Atlas connection string and allow Vercel network access (0.0.0.0/0).
MONGODB_URI=mongodb+srv://user:password@cluster/jss_eliteshop

BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public URL of this backend, e.g. https://your-server.vercel.app
BETTER_AUTH_URL=http://localhost:5000

IMGBB_API_KEY=

# Gemini AI (server only, never expose this to the client)
GEMINI_API_KEY=
# Optional overrides, these are the defaults:
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
